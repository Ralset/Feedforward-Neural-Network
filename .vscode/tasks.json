{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cmake build",
            "type": "shell",
            "command": "cmake -B build && cmake --build build",
            "problemMatcher": "$gcc",
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "./build/Feedforward_Neural_Network",
            "dependsOn": "Cmake build",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}